{
  "name": "trial-manager",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src scripts vite.config.js vitest.config.ts eslint.config.js tailwind.config.js postcss.config.js",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "node scripts/run-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "test:db": "node --test scripts/database.test.mjs",
    "test:edge": "node --experimental-vm-modules --test scripts/edge-security.test.mjs",
    "test:concurrency": "node --test scripts/concurrency.test.mjs",
    "check:edge": "node scripts/check-edge.mjs",
    "build:verify": "node scripts/verify-build.mjs",
    "db:bootstrap": "node scripts/bootstrap-db.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.91.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.562.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "pg": "^8.23.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}
